   "source": [
    "import numpy as np\n",
    "\n",
    "W = np.array([\n",
    "    [-1.0, -0.5],\n",
    "    [0.25, 0.75]\n",
    "], dtype=np.float32)\n",
    "\n",
    "scale = np.max(np.abs(W)) / 127\n",
    "\n",
    "W_quantized = np.round(W / scale).astype(np.int8)\n",
    "\n",
    "print(W_quantized)"
   ]
